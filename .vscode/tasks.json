{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build main paper (LuaLaTeX)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build main paper and research notes",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "--all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify finite calculations",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/verify_all.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Make current research bundle",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/make_bundle.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
